# Simpan definisi upstream di /etc/nginx/conf.d/sicma-upstream.conf agar deploy.sh
# bisa memindahkan trafik Blue-Green secara otomatis tanpa downtime:
#
# upstream sicma_app {
#     server 127.0.0.1:8001;
#     keepalive 16;
# }

server {
    listen 80;
    listen [::]:80;
    server_name sicma.example.ac.id;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sicma.example.ac.id;

    # Isi path sertifikat SSL (misalnya dari Certbot / Let's Encrypt)
    ssl_certificate     /etc/letsencrypt/live/sicma.example.ac.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sicma.example.ac.id/privkey.pem;

    client_max_body_size 25M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # WebSocket Laravel Reverb (port internal 8080)
    location ~ ^/apps? {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
    }

    # Aplikasi Laravel SICMA via upstream Blue-Green (/etc/nginx/conf.d/sicma-upstream.conf)
    location / {
        proxy_pass http://sicma_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
