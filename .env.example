APP_NAME=SICMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
# Port cadangan untuk slot Blue-Green saat deploy tanpa downtime di VPS
APP_GREEN_PORT=8002
# Set "*" di VPS saat berada di balik reverse proxy (Nginx/Caddy/Cloudflare)
TRUSTED_PROXIES=
# Set 1 saat build produksi di VPS agar paket dev (composer --no-dev) tidak ikut terpasang
COMPOSER_NO_DEV=0

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=sicma
DB_USERNAME=sicma
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
FORWARD_DB_PORT=3307

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true di VPS saat memakai HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=sicma-app
REVERB_APP_KEY=sicma-key
REVERB_APP_SECRET=sicma-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Di produksi, batasi ke domain aplikasi (mis. sicma.example.ac.id)
REVERB_ALLOWED_ORIGINS=*

SICMA_ADMIN_NAME="Admin SICMA"
SICMA_ADMIN_EMAIL=
SICMA_ADMIN_PASSWORD=
SICMA_SCHEDULER_MODE=queue
# Ubah menjadi false atau "Jadwal resmi" di produksi agar tidak tampil "Data simulasi"
SICMA_SHOW_DATA_LABEL=true
SICMA_DATA_LABEL="Data simulasi"
